# Copy to backend/.env. Never commit .env.
# ORCHESTRATOR_ROLE is set by the npm scripts (dev:api / dev:worker), not here.

NODE_ENV=development
PORT=4000

# Supabase → Project Settings → Database → Connection string → Session pooler (port 5432)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

REDIS_URL="redis://127.0.0.1:6379"

API_URL="http://localhost:4000"
ADMIN_URL="http://localhost:3000"

# api role only ---------------------------------------------------------------
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL: http://localhost:4000/v1/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Comma-separated GitHub logins that receive the admin role on sign-in
ADMIN_GITHUB_LOGINS=""

# Repository provisioning ---------------------------------------------------------
GITHUB_ORG="plinth-pages"
GITHUB_TEMPLATE_REPO="plinth-template"

# worker role only ------------------------------------------------------------------
# Don't fill these by hand: sign in as an admin, open http://localhost:4000/v1/dev/github-app/new,
# and the manifest flow writes both values here. Then install the App on the org (all repositories).
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# Preview sandboxes (worker role only) ----------------------------------------------
# e2b.dev/dashboard → API keys. Set a spending limit on the dashboard's budget page too.
E2B_API_KEY=""
# Built once with: node scripts/build-e2b-template.js (re-run when plinth-template's dependencies change)
E2B_TEMPLATE="plinth-portfolio"
# Running sandboxes are billed per second; paused ones are free and resume in about a second.
SANDBOX_IDLE_PAUSE_MINUTES=5
SANDBOX_DESTROY_AFTER_PAUSED_HOURS=24
# E2B Hobby caps continuous runtime at 60 minutes; active sandboxes are paused and resumed before then.
SANDBOX_ROTATE_AFTER_MINUTES=50

# Preview proxy (api role) ----------------------------------------------------------
# Sandboxes reject traffic without their access token; browsers reach previews through this proxy.
PREVIEW_PROXY_PORT=4100
# {session} becomes an unguessable label. *.localhost resolves to 127.0.0.1 in Chrome, Edge and Firefox.
# Production: https://{session}.preview.<your-domain> with wildcard DNS and a wildcard certificate.
PREVIEW_URL_TEMPLATE="http://{session}.preview.localhost:4100"

# Portfolio repositories -------------------------------------------------------------
# public: Vercel's Hobby plan can deploy them (it can't deploy private repositories owned by an organisation).
# private: requires Vercel Pro. Changing this affects new portfolios only.
PORTFOLIO_REPO_VISIBILITY=public

# Hosting (worker role) ----------------------------------------------------------------
# Without VERCEL_TOKEN, Publish still promotes draft to main but deploys nothing.
# vercel.com/account/settings/tokens — scope: the account or team that will own the portfolio projects.
VERCEL_TOKEN=""
# Only if the projects live in a Vercel team (Settings → General → Team ID). Leave empty for a personal account.
VERCEL_TEAM_ID=""
