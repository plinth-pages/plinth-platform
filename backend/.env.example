# Copy to backend/.env. Never commit .env.
# ORCHESTRATOR_ROLE is set by the npm scripts (dev:api / dev:worker), not here.

NODE_ENV=development
PORT=4000

# Supabase → Project Settings → Database → Connection string → Session pooler (port 5432)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

REDIS_URL="redis://127.0.0.1:6379"

API_URL="http://localhost:4000"
ADMIN_URL="http://localhost:3000"

# The public address of this API, baked into installed integrations that call it from a visitor's browser
# (Visitor Counter). In production it must be the real origin — localhost there is the visitor's own machine,
# so the integration fails silently. Boot refuses to start if it still points at localhost when NODE_ENV=production.
PUBLIC_API_URL="http://localhost:4000"

# api role only ---------------------------------------------------------------
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL: http://localhost:4000/v1/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Comma-separated GitHub logins that receive the admin role on sign-in
ADMIN_GITHUB_LOGINS=""

# Repository provisioning ---------------------------------------------------------
GITHUB_ORG="plinth-pages"
GITHUB_TEMPLATE_REPO="plinth-template"

# worker role only ------------------------------------------------------------------
# Don't fill these by hand: sign in as an admin, open http://localhost:4000/v1/dev/github-app/new,
# and the manifest flow writes both values here. Then install the App on the org (all repositories).
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# Preview sandboxes (worker role only) ----------------------------------------------
# e2b.dev/dashboard → API keys. Set a spending limit on the dashboard's budget page too.
E2B_API_KEY=""
# Built once with: node scripts/build-e2b-template.js (re-run when plinth-template's dependencies change)
E2B_TEMPLATE="plinth-portfolio"
# Running sandboxes are billed per second; paused ones are free and resume in about a second.
SANDBOX_IDLE_PAUSE_MINUTES=5
SANDBOX_DESTROY_AFTER_PAUSED_HOURS=24
# E2B Hobby caps continuous runtime at 60 minutes; active sandboxes are paused and resumed before then.
SANDBOX_ROTATE_AFTER_MINUTES=50

# Preview proxy (api role) ----------------------------------------------------------
# Sandboxes reject traffic without their access token; browsers reach previews through this proxy.
PREVIEW_PROXY_PORT=4100
# {session} becomes an unguessable label. *.localhost resolves to 127.0.0.1 in Chrome, Edge and Firefox.
# Production: https://{session}.<your-domain> (or {session}.preview.<your-domain>) with wildcard DNS and a wildcard certificate.
# Behind an edge that forwards previews under its own hostname (e.g. a Cloudflare Worker), the header that carries the
# preview hostname. Leave unset when previews reach this server directly.
# PREVIEW_HOST_HEADER="x-plinth-preview-host"
PREVIEW_URL_TEMPLATE="http://{session}.preview.localhost:4100"

# Portfolio repositories -------------------------------------------------------------
# public: Vercel's Hobby plan can deploy them (it can't deploy private repositories owned by an organisation).
# private: requires Vercel Pro. Changing this affects new portfolios only.
PORTFOLIO_REPO_VISIBILITY=public

# Hosting (worker role) ----------------------------------------------------------------
# Without VERCEL_TOKEN, Publish still promotes draft to main but deploys nothing.
# vercel.com/account/settings/tokens — scope: the account or team that will own the portfolio projects.
VERCEL_TOKEN=""
# Only if the projects live in a Vercel team (Settings → General → Team ID). Leave empty for a personal account.
VERCEL_TEAM_ID=""

# Plinth AI providers ------------------------------------------------------------------
# Each is optional; a model is offered when any of its routes has a key. See src/ai/ai-models.ts.
# GROQ_API_KEY=""            # Free tier (default model)
# NVIDIA_API_KEY=""          # build.nvidia.com — the free tier's fallback (Llama 3.3 70B)
# OPENROUTER_API_KEY=""      # openrouter.ai — Pro models through one prepaid account (GPT-4o by default)
# ANTHROPIC_API_KEY=""       # Claude directly
# OPENAI_API_KEY=""          # OpenAI directly (use OPENROUTER_API_KEY for OpenRouter keys)
# AGENTROUTER_API_KEY=""     # agentrouter.org — only used by models that name it in AI_MODELS
# AGENTROUTER_BASE_URL="https://agentrouter.org/v1"
# Edit or add models without code (JSON array):
# AI_MODELS='[{"id":"claude-3-5-sonnet","alternates":[{"provider":"openrouter","model":"anthropic/claude-sonnet-4.5"}]}]'
# More OpenAI-compatible services (the key goes in the variable named by apiKeyEnv):
# AI_PROVIDERS='[{"id":"together","baseUrl":"https://api.together.xyz/v1","apiKeyEnv":"TOGETHER_API_KEY"}]'

# Razorpay — how Pro is paid for (UPI, cards, netbanking). Standard Checkout: each payment buys a pass, nothing auto-renews.
# RAZORPAY_KEY_ID="rzp_test_…"
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""              # the secret typed into Razorpay's webhook settings
# RAZORPAY_PRO_PRICE_PAISE=120000        # ₹1,200 for 30 days
# RAZORPAY_PRO_YEAR_PRICE_PAISE=1200000  # ₹12,000 for a year — a year costs ten months
# RAZORPAY_CURRENCY=INR                  # anything else must be enabled on the Razorpay account
# RAZORPAY_PASSES=                       # replaces both passes: [{"id","label","days","amount"}]
