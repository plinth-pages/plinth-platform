{
  "name": "@plinth-pages/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev:api": "cross-env ORCHESTRATOR_ROLE=api nest start --watch",
    "dev:worker": "cross-env ORCHESTRATOR_ROLE=worker nest start --watch",
    "start:api": "cross-env ORCHESTRATOR_ROLE=api node dist/main.js",
    "start:worker": "cross-env ORCHESTRATOR_ROLE=worker node dist/main.js",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:int": "jest --testRegex \"\\.int-spec\\.ts$\" --runInBand",
    "e2b:template": "node scripts/build-e2b-template.js"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1131.0",
    "@nestjs/bullmq": "^11",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^11",
    "@nestjs/platform-express": "^11",
    "@plinth-pages/codemod": "workspace:^",
    "@plinth-pages/integration-types": "file:../vendor/plinth-pages-integration-types-0.1.0.tgz",
    "@prisma/client": "^6",
    "bullmq": "^5",
    "cookie-parser": "^1",
    "e2b": "^2",
    "groq-sdk": "^1.6.0",
    "http-proxy-3": "2.0.1",
    "ioredis": "5.11.1",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@plinth-pages/shared": "workspace:^",
    "@types/cookie-parser": "^1",
    "@types/express": "^5",
    "@types/jest": "^29",
    "@types/node": "^20",
    "cross-env": "^7",
    "jest": "^29",
    "prisma": "^6",
    "ts-jest": "^29",
    "typescript": "^5.7"
  }
}
