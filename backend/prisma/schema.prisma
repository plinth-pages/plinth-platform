// Plinth orchestrator schema — Phase 0.
// Tables exist so later phases have somewhere to land; columns are added when a phase needs them.
//
// DATABASE_URL points at Supabase's session pooler (port 5432). The backend is a long-running
// process, not serverless, so session mode is correct and also supports migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

model User {
  id          String   @id @default(cuid())
  /// Set for GitHub sign-in.
  githubId    String?  @unique @map("github_id")
  /// Set for email sign-in (Supabase Auth user id).
  supabaseId  String?  @unique @map("supabase_id")
  email       String?
  githubLogin String   @map("github_login")
  name        String?
  avatarUrl   String?  @map("avatar_url")
  role        UserRole @default(user)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  portfolios          Portfolio[]
  integrationRequests IntegrationRequest[]
  copilotMessages     CopilotMessage[]

  @@map("users")
}

enum PortfolioStatus {
  provisioning
  ready
  failed
}

enum PortfolioRole {
  developer
  designer
  student
  creator
  freelancer
  founder
  researcher
  other
}

model Portfolio {
  id                     String          @id @default(cuid())
  userId                 String          @map("user_id")
  role                   PortfolioRole
  slug                   String?         @unique
  status                 PortfolioStatus @default(provisioning)
  // Chosen at creation, before the repository exists, so a retry always targets the same name.
  repoName               String          @unique @map("repo_name")
  repoId                 String?         @map("repo_id")
  vercelProjectId        String?         @map("vercel_project_id")
  failureReason          String?         @map("failure_reason")
  /// Look chosen during onboarding ({ mode, accent }); written into content/theme.ts by personalisation.
  theme                  Json?
  /// The first change: GitHub profile, role content and theme. Set once, so it is queued at most once.
  personaliseOperationId String?         @map("personalise_operation_id")
  provisionAttempts      Int             @default(0) @map("provision_attempts")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sandbox               Sandbox?
  operations            Operation[]
  deployments           Deployment[]
  installedIntegrations InstalledIntegration[]
  copilotMessages       CopilotMessage[]
  visitorCount          VisitorCount?
  credentials           Credential[]
  conversations         Conversation[]

  @@index([userId])
  @@index([status, updatedAt])
  @@map("portfolios")
}

// starting  — being created, bootstrapped or recovered (a worker holds the portfolio's sandbox lock)
// running   — live; the dev server answered at the last check
// paused    — snapshotted; costs nothing, resumes in about a second
// destroyed — no live sandbox; the next visit rebuilds it from the draft branch
// unhealthy — no live sandbox, because the last start failed (see last_error)
enum SandboxStatus {
  starting
  running
  paused
  destroyed
  unhealthy
}

model Sandbox {
  id             String        @id @default(cuid())
  portfolioId    String        @unique @map("portfolio_id")
  provider       String        @default("e2b")
  externalId     String?       @map("external_id")
  status         SandboxStatus @default(destroyed)
  /**
   * The provider URL of the dev server. Not reachable without `trafficToken`; browsers use the preview proxy.
   */
  previewUrl     String?       @map("preview_url")
  /**
   * Sent by the preview proxy as `e2b-traffic-access-token`. Null only for sandboxes created before gate G2.
   */
  trafficToken   String?       @map("traffic_token")
  /**
   * Updated by the IDE heartbeat. Idle time is measured from here.
   */
  lastAccessedAt DateTime?     @map("last_accessed_at")
  /**
   * Start of the current billed stretch (create or resume). Null unless running.
   */
  runStartedAt   DateTime?     @map("run_started_at")
  /**
   * When the provider will pause the sandbox on its own if nothing extends it.
   */
  expiresAt      DateTime?     @map("expires_at")
  pausedAt       DateTime?     @map("paused_at")
  secondsUsed    Int           @default(0) @map("seconds_used")
  coldStartMs    Int?          @map("cold_start_ms")
  resumeMs       Int?          @map("resume_ms")
  lastError      String?       @map("last_error")
  /**
   * A commit was applied in the sandbox but not yet pushed to draft. It must be pushed before the sandbox is destroyed.
   */
  pendingPush    Boolean       @default(false) @map("pending_push")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("sandboxes")
}

enum OperationType {
  edit
  install
  uninstall
  move
  theme
  fleet_update
  publish
  copilot
}

enum OperationActor {
  user
  copilot
  system
}

enum OperationStatus {
  queued
  staging
  checking
  applying
  applied
  rejected
  reverted
  failed
}

// Every change to a portfolio's code runs as an operation: staged in a worktree, formatted, validated by plinth check,
// type-checked, and only then committed to the live tree and pushed to draft (Phase 5).
model Operation {
  id          String          @id @default(cuid())
  portfolioId String          @map("portfolio_id")
  type        OperationType
  actor       OperationActor
  status      OperationStatus @default(queued)
  /**
   * Short description, used as the commit subject.
   */
  summary     String
  input       Json
  diff        String?
  /**
   * Parsed failures from plinth check, tsc or the render health check.
   */
  checkOutput Json?           @map("check_output")
  /**
   * Infrastructure failure message (status failed).
   */
  error       String?
  attempts    Int             @default(0)
  commitSha   String?         @map("commit_sha")
  revertSha   String?         @map("revert_sha")
  /**
   * Duration of plinth check + tsc, for the p50/p95 budget.
   */
  checkMs     Int?            @map("check_ms")
  totalMs     Int?            @map("total_ms")
  createdAt   DateTime        @default(now()) @map("created_at")
  startedAt   DateTime?       @map("started_at")
  finishedAt  DateTime?       @map("finished_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
  @@index([portfolioId, status])
  @@map("operations")
}

// unconfigured — main was updated, but no hosting provider is connected yet, so nothing was deployed (gate G3)
enum DeploymentStatus {
  pending
  building
  ready
  failed
  unconfigured
}

// One row per publish that reached main.
model Deployment {
  id                 String           @id @default(cuid())
  portfolioId        String           @map("portfolio_id")
  /**
   * The publish operation that promoted this commit.
   */
  operationId        String?          @unique @map("operation_id")
  status             DeploymentStatus @default(pending)
  commitSha          String           @map("commit_sha")
  vercelDeploymentId String?          @map("vercel_deployment_id")
  url                String?
  error              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  finishedAt         DateTime?        @map("finished_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
  @@map("deployments")
}

// The catalogue. Rows are ingested from integration packages; the manifest is the validated plinth.manifest.json.
model Integration {
  id            String   @id // e.g. "leetcode-stats"
  name          String
  category      String
  packageName   String   @map("package_name")
  latestVersion String   @map("latest_version")
  manifest      Json
  /**
   * Vendored tarball under integrations/, installed as file:vendor/<name>. Null means install from the npm registry.
   */
  tarball       String?
  isActive      Boolean  @default(false) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  installs InstalledIntegration[]

  @@map("integrations")
}

model InstalledIntegration {
  id            String   @id @default(cuid())
  portfolioId   String   @map("portfolio_id")
  integrationId String   @map("integration_id")
  version       String
  slot          String
  props         Json
  createdAt     DateTime @default(now()) @map("created_at")

  portfolio   Portfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id])

  @@unique([portfolioId, integrationId])
  @@map("installed_integrations")
}

/// A user asking for an integration that isn't built yet. One vote per user per integration; the superadmin ranks by count.
model IntegrationRequest {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  /// A planned catalogue id ("spotify"), or `suggested:<slug>` for something not on the list.
  key         String
  name        String
  note        String?
  portfolioId String?  @map("portfolio_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([key])
  @@map("integration_requests")
}

enum CopilotRole {
  user
  assistant
}

/// The co-pilot conversation for a portfolio. A user message creates a `copilot` operation; the worker writes the
/// assistant reply (with token usage) when it plans that operation.
model CopilotMessage {
  id           String      @id @default(cuid())
  portfolioId  String      @map("portfolio_id")
  userId       String      @map("user_id")
  role         CopilotRole
  content      String
  /// Model registry id, e.g. "claude-3-haiku".
  model        String?
  operationId  String?     @map("operation_id")
  /// Files the reply changed and integrations it queued, for the chat to show.
  changes      Json?
  refused      Boolean     @default(false)
  inputTokens  Int?        @map("input_tokens")
  outputTokens Int?        @map("output_tokens")
  latencyMs    Int?        @map("latency_ms")
  createdAt    DateTime    @default(now()) @map("created_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
  @@index([userId, createdAt])
  @@map("copilot_messages")
}

/// A user secret, sealed with AES-256-GCM (credentials/vault.ts). Plaintext exists only in memory, in the sandbox
/// .env.local, and as a sensitive Vercel environment variable.
model Credential {
  id            String    @id @default(cuid())
  portfolioId   String    @map("portfolio_id")
  key           String // environment variable name, e.g. RESEND_API_KEY
  /// The integration that declared it.
  integrationId String    @map("integration_id")
  ciphertext    String
  iv            String
  keyId         String    @map("key_id")
  /// Safe to display, e.g. "•••• 4f2a".
  hint          String
  verifiedAt    DateTime  @map("verified_at")
  /// When production (Vercel) last received the current value; null until the next publish.
  syncedAt      DateTime? @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, key])
  @@map("credentials")
}

/// Visitor Counter integration: one row per portfolio. The documented exception to "the portfolio doesn't depend on us".
model VisitorCount {
  portfolioId String   @id @map("portfolio_id")
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("visitor_counts")
}

model Conversation {
  id          String   @id @default(cuid())
  portfolioId String   @map("portfolio_id")
  createdAt   DateTime @default(now()) @map("created_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([portfolioId])
  @@map("conversations")
}

enum MessageRole {
  user
  assistant
  tool
}

model Message {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        Json
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}
