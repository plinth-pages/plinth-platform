{
  "name": "plinth-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:api": "pnpm --filter @plinth-pages/backend dev:api",
    "dev:worker": "pnpm --filter @plinth-pages/backend dev:worker",
    "dev:admin": "pnpm --filter @plinth-pages/admin dev",
    "test": "pnpm --filter @plinth-pages/backend test",
    "typecheck": "pnpm -r typecheck",
    "build:packages": "pnpm --filter @plinth-pages/codemod build"
  },
  "engines": {
    "node": ">=22"
  }
}
